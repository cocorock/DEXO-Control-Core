<?xml version="1.0"?>
<launch>
  <!-- 
    Automated Dual Bluetooth Smart Crutch Launch File
    
    This launch file includes automatic dual Bluetooth setup before starting the ROS node.
    Supports both right and left crutches with priority logic.
    
    Arguments:
      - auto_setup (default: true): Whether to run automatic Bluetooth setup
      - bluetooth_right_device (default: /dev/rfcomm0): Right crutch device path
      - bluetooth_left_device (default: /dev/rfcomm1): Left crutch device path
      - esp32_right_mac (default: 24:6F:28:D1:36:72): Right ESP32 MAC address
      - esp32_left_mac (default: 24:6f:28:45:d3:76): Left ESP32 MAC address
      - debug_output (default: true): Enable verbose logging
  -->

  <!-- Launch arguments - Dual Crutch Support -->
  <arg name="auto_setup" default="true" doc="Run automatic dual Bluetooth setup before launching node"/>
  <arg name="bluetooth_right_device" default="/dev/rfcomm0" doc="Right crutch Bluetooth device path"/>
  <arg name="bluetooth_left_device" default="/dev/rfcomm1" doc="Left crutch Bluetooth device path"/>
  <arg name="esp32_right_mac" default="24:6F:28:D1:36:72" doc="Right ESP32 MAC address (priority device)"/>
  <arg name="esp32_left_mac" default="24:6f:28:45:d3:76" doc="Left ESP32 MAC address"/>
  <arg name="debug_output" default="true" doc="Enable debug output"/>
  
  <!-- Automatic Bluetooth Setup Node (optional) -->
  <group if="$(arg auto_setup)">
    <node name="bluetooth_setup" pkg="exoskeleton_control" type="setup_bluetooth_crutch.sh" 
          output="screen" launch-prefix="bash -c 'sleep 1; exec'" />
    
    <!-- Small delay to ensure setup completes before starting main node -->
    <param name="/bluetooth_setup_delay" value="3.0"/>
  </group>

  <!-- Load configuration for the bluetooth crutch node -->
  <rosparam file="$(find exoskeleton_control)/config/bluetooth_crutch_config.yaml" command="load" ns="bluetooth_crutch_node"/>

  <!-- Override parameters with launch arguments - Dual Crutch Support -->
  <param name="/bluetooth_crutch_node/bluetooth_right_device" value="$(arg bluetooth_right_device)"/>
  <param name="/bluetooth_crutch_node/bluetooth_left_device" value="$(arg bluetooth_left_device)"/>
  <param name="/bluetooth_crutch_node/debug_output" value="$(arg debug_output)"/>

  <!-- Bluetooth Crutch Node -->
  <node name="bluetooth_crutch_node" pkg="exoskeleton_control" type="bluetooth_crutch_node.py" 
        output="screen" launch-prefix="bash -c 'sleep 5; exec'">
    
    <!-- Topic remapping -->
    <remap from="/crutch/state" to="/crutch/state"/>
    <remap from="/crutch/sensor_data" to="/crutch/sensor_data"/>
    
  </node>

  <!-- Optional: Node to monitor dual Bluetooth connection health -->
  <node name="bluetooth_monitor" pkg="exoskeleton_control" type="bluetooth_crutch_node.py" 
        output="log" if="false">
    <!-- This could be extended to restart dual connections automatically -->
  </node>

</launch>