<?xml version="1.0"?>
<launch>
  <!-- 
    Launch file for the Bluetooth Smart Crutch node.
    
    Prerequisites:
    1. Pair the ESP32 device with the system
    2. Connect via RFCOMM: sudo rfcomm connect 0 24:6F:28:D1:36:72 1
    3. Set permissions: sudo chmod 666 /dev/rfcomm0
    
    The ESP32 should be running MultisensorESP32_PT-CRUTCH_HMI-SYSTEM_V2.ino
    with USE_COMPACT_FORMAT enabled.
  -->

  <!-- Load configuration for the bluetooth crutch node -->
  <rosparam file="$(find exoskeleton_control)/config/bluetooth_crutch_config.yaml" command="load" ns="bluetooth_crutch_node"/>

  <!-- Bluetooth Crutch Node -->
  <node name="bluetooth_crutch_node" pkg="exoskeleton_control" type="bluetooth_crutch_node.py" output="screen">
    
    <!-- Node parameters can be overridden here -->
    <!-- <param name="bluetooth_device" value="/dev/rfcomm0"/> -->
    <!-- <param name="debug_output" value="true"/> -->
    
    <!-- Topic remapping -->
    <remap from="/crutch/state" to="/crutch/state"/>
    <remap from="/crutch/sensor_data" to="/crutch/sensor_data"/>
    
  </node>

  <!-- Optional: Launch rviz or other visualization tools -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find exoskeleton_control)/rviz/crutch_visualization.rviz"/> -->

</launch>